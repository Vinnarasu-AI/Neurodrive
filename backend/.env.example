# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Serial Connection (NPG Lite)
# e.g., COM5 on Windows or /dev/ttyUSB0 on Linux. Leave empty or "AUTO" for auto-detection.
NPG_SERIAL_PORT=AUTO
NPG_BAUD_RATE=230400
NPG_CHANNELS=3
NPG_SAMPLE_RATE=500
USE_MOCK_SERIAL=true  # Set false when real NPG Lite hardware is connected

# Separate ESP32 Relay Configuration
RELAY_BASE_URL=http://192.168.1.150
RELAY_AUTH_TOKEN=neurodrive_secure_token_abc123
RELAY_TIMEOUT_SEC=2.0
RELAY_POLARITY=ACTIVE_LOW # or ACTIVE_HIGH
USE_MOCK_RELAY=true # Set false when ESP32 relay board is connected on local Wi-Fi

# Database
DATABASE_URL=sqlite+aiosqlite:///./neurodrive.db

# DSP & Gesture Detection Defaults
BANDPASS_LOW_HZ=0.5
BANDPASS_HIGH_HZ=15.0
NOTCH_FREQ_HZ=50.0
DOUBLE_BLINK_MIN_GAP_MS=150
DOUBLE_BLINK_MAX_GAP_MS=850
REFRACTORY_PERIOD_MS=600
PEAK_MIN_AMPLITUDE_UV=250.0

